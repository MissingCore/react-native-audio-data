{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["audiodata"],
  "ios": {
    "iosModuleName": "AudioData"
  },
  "android": {
    "androidNamespace": ["audiodata"],
    "androidCxxLibName": "audiodata"
  },
  "autolinking": {
    "AudioData": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridAudioData"
      }
    },
    "FileHelper": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFileHelper"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFileHelper"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
